# OpenClaw 仓库挂载环境变量配置
# 使用方法：在运行 ./setup.sh 之前先 source 这个文件
# 示例：source set-repo-mounts.env && ./setup.sh

# ══ 挂载路径配置 ══════════════════════════════════════════════
# Windows 仓库
export OPENCLAW_EXTRA_MOUNTS="/home/qzx/projects:/projects:rw,/mnt/d/repo:/repo:rw,/mnt/d/log:/log:r"
# ════════════════════════════════════════════════════════════
